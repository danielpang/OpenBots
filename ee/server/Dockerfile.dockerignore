# Build context exclusions for ee/server/Dockerfile (the managed image). BuildKit reads
# <Dockerfile>.dockerignore next to the Dockerfile in preference to a
# .dockerignore at the context root, so this applies to `docker build -f
# ee/server/Dockerfile .`.
.git
.github
**/node_modules
**/dist
**/.turbo
**/coverage
**/*.tsbuildinfo
**/*.log
.env
.env.*
!.env.example
**/.DS_Store
