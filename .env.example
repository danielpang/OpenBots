# OpenBots configuration (plan 16.2). Copy to `.env` and edit:
#
#   cp .env.example .env
#
# Docker Compose passes this file to the openbots container and reads it for the
# ${...} values in the compose files. Empty values count as unset. Keep comments
# on their own lines.

# --- Required -----------------------------------------------------------------

# Where people and services reach this instance. Used for webhook URLs, OAuth
# callbacks and notification links. Set it to your tunnel URL when you expose
# OpenBots to the internet (see "Exposing your OpenBots server to the internet" in the
# README).
OPENBOTS_PUBLIC_URL=http://localhost:3000

# The private relay that lets the OpenBots phone app reach this server with no
# public URL and no open port. The relay only passes encrypted bytes between
# your phone and this server; it cannot read them. The server dials out to it
# only once a phone is paired (or a pairing is waiting), never before. Leave it
# empty to turn the relay off: phones then connect only to OPENBOTS_PUBLIC_URL,
# which must be https. To run your own relay (the `relay` compose profile,
# below), put its wss:// URL here.
OPENBOTS_RELAY_URL=

# 32 random bytes, base64. Encrypts every stored secret and signs sessions.
# Generate one with `docker compose run --rm openbots keygen` and paste it here.
# Keep a copy somewhere safe: without it, backups cannot be decrypted.
# Any secret in this file may instead be given as a file, NAME_FILE=/path
# (OPENBOTS_MASTER_KEY_FILE, DATABASE_URL_FILE and so on), such as a Docker
# secret. The compose service does this for you: its entrypoint moves the
# secrets into private files before the server starts.
OPENBOTS_MASTER_KEY=

# Only while rotating the master key (see "Rotating the master key" in the
# README): the old key, or several separated by commas. They still open
# secrets stored under them, and `docker compose run --rm openbots rotate-key`
# re-encrypts those under OPENBOTS_MASTER_KEY. Remove them when it reports done.
OPENBOTS_MASTER_KEY_PREVIOUS=

# The compose stack's Postgres and Redis. Change only if you run your own.
# install.sh and the Mac app's local stack generate POSTGRES_PASSWORD and write
# the same password into DATABASE_URL in place of change-me. By hand, generate
# one (for example `openssl rand -hex 24`) and put it in both. Postgres reads
# it only when it creates the database, so to change it later run
# `docker compose exec postgres psql -U openbots -c "ALTER USER openbots PASSWORD '<new>'"`
# and then update both lines.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://openbots:change-me@postgres:5432/openbots
# The app works as openbots_app, a database role that owns nothing and is held
# to row-level security between organizations; migrations run as the user in
# DATABASE_URL. install.sh and the Mac app's local stack generate this
# password (16 to 128 letters, digits, - or _). Left empty, the app connects
# as DATABASE_URL's user and switches to openbots_app in every transaction.
OPENBOTS_DB_APP_PASSWORD=
REDIS_URL=redis://redis:6379

# --- Sign-up and sign-in ------------------------------------------------------

# self_hosted (default) | managed. A self-hosted install has one account, its
# owner, created by the first-run wizard; after that sign-up is closed and
# there are no organizations, members, invites or audit log screens. `managed`
# is the hosted OpenBots service: many organizations on one server, each with
# owners, admins and members. It runs from the managed build (ee/server).
OPENBOTS_DEPLOYMENT=self_hosted

# Set by the standalone image (docker/standalone.Dockerfile), not by hand: it
# runs the whole of OpenBots in one container, and with it the server refuses
# OPENBOTS_DEPLOYMENT=managed.
OPENBOTS_STANDALONE=

# Self-hosted only: 1 makes the first owner by pairing a phone only. The web
# wizard's account step and the email sign-up are refused (403
# SETUP_PAIRING_ONLY) while there is no owner, and the web app says to run
# `openbots pair` instead. The standalone image sets it, so nobody who finds
# the port first claims the install.
OPENBOTS_SETUP_PAIRING_ONLY=

# Self-hosted only, set by the Mac app: the token its main process signs the
# owner in with, so the app on This Mac has no sign-in or sign-up. Leave it
# empty on a server people reach over the network or from a browser.
OPENBOTS_LOCAL_TOKEN=

# Managed only: open | invite (first_user_admin is its old name). `open` lets
# anyone sign up and create an organization; `invite` lets only the first
# user and people with a pending invitation. Self-hosted ignores it.
OPENBOTS_SIGNUP_MODE=first_user_admin

# Whether admins may mark a provider, connector or event subscription as on
# their own network, so it may reach private addresses (S-8). Defaults to true
# on a self-hosted install and false on the managed service, where every
# organization shares the server's network.
OPENBOTS_LOCAL_ENDPOINTS=

# Whether admins may turn on custom command (stdio) connectors, which run a
# program on this server (S-1). Defaults to true on a self-hosted install and
# false on the managed service, whose server every organization shares.
OPENBOTS_CUSTOM_STDIO=

# Where stdio connectors (Filesystem, Postgres, custom commands) run: host runs
# them on this server as an unprivileged user; computer runs each in its
# owner's computer, which needs DOCKER_HOST or OPENBOTS_COMPUTER_AGENT_URL.
# Defaults to host on a self-hosted install and computer on the managed
# service, which refuses host unless OPENBOTS_ALLOW_HOST_STDIO=1.
OPENBOTS_STDIO_RUNNER=
OPENBOTS_ALLOW_HOST_STDIO=

# Managed only: invite and email verification emails through Resend. Without a
# key, invites are links to copy and new accounts cannot confirm their email.
# OPENBOTS_EMAIL_FROM is the sender, such as "OpenBots <hi@example.com>".
RESEND_API_KEY=
OPENBOTS_EMAIL_FROM=

# Managed, development only: with no email set up, log the 6-digit email
# verification codes so you can enter them. The server refuses it with
# NODE_ENV=production.
OPENBOTS_DEV_LOG_EMAIL_LINKS=

# GitHub MCP connector AND coding repositories: public GitHub App client ID and
# slug, with Device Flow enabled. Install on selected repositories. No private
# key, client secret or callback is needed, including refresh. See
# docs/GITHUB_CONNECTOR.md and docs/GITHUB_REPOSITORIES.md.
# Override both values to use your own app instead of the bundled public app.
OPENBOTS_GITHUB_CLIENT_ID=
OPENBOTS_GITHUB_APP_SLUG=

# Optional "Sign in with GitHub / Google". Each turns on when both its id and
# secret are set. Callback URL: <OPENBOTS_PUBLIC_URL>/api/auth/callback/github
# (or /google).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional server-managed GitHub App (installation tokens and App webhooks).
# NOT needed for the default coding-repository device flow above. Self-hosters
# can instead create this App through the Advanced manifest flow (public HTTPS
# required). Never bundle these secrets in a client or public app. The key goes on one
# line with \n for each line break, or as GITHUB_APP_PRIVATE_KEY_FILE; the
# three secrets (private key, client secret, webhook secret) can be given as
# NAME_FILE like the others. The App must have "Request user authorization
# (OAuth) during installation" turned on, and GITHUB_APP_CLIENT_ID and
# GITHUB_APP_CLIENT_SECRET set to its client id and secret, or installations
# cannot be bound to the owner who installed them.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=

# --- Model providers ----------------------------------------------------------

# Any of these enables the built-in provider. Keys can also be added later in
# Settings > Models.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional, e.g. http://host.docker.internal:11434 for Ollama on the host.
# Other custom model providers are added in Settings > Models.
OLLAMA_BASE_URL=

# --- The computer -------------------------------------------------------------

# The restricted Docker API from the docker-guard service, which checks every
# request before the socket proxy sees it. The computer refuses any other
# Docker API (the socket proxy or the Docker socket itself).
DOCKER_HOST=tcp://docker-guard:2375
# The only image computers may run; the docker guard enforces it. Empty means
# the computer image of the same release as the server:
# ${OPENBOTS_IMAGE_PREFIX}/computer:${OPENBOTS_VERSION}.
OPENBOTS_SANDBOX_IMAGE=
# Optional: an HTTP proxy for the computers' web traffic, with its port, e.g.
# http://172.30.255.3:8888 for the `egress` compose profile's allowlisting
# proxy. The sandbox firewall lets the computers reach this address even when it
# is private. Hosts in OPENBOTS_SANDBOX_NO_PROXY skip it (default
# localhost,127.0.0.1). A change applies when each computer next starts.
OPENBOTS_SANDBOX_EGRESS_PROXY=
OPENBOTS_SANDBOX_NO_PROXY=
# The computers' timezone, an IANA name such as Europe/London or
# America/New_York: the clock the Bots' shells, browsers and the wallpaper use.
# Defaults to UTC. A change applies when each computer next starts.
OPENBOTS_TIMEZONE=UTC
# Optional: use a control agent already running on another machine (a VM)
# instead of Docker. It is one machine with one /home/bot, so it suits
# single-person installs: the first account to use it keeps it, and the
# computer is unavailable to every other account.
OPENBOTS_COMPUTER_AGENT_URL=
OPENBOTS_COMPUTER_AGENT_TOKEN=
# true lets every account use that one machine. Each Bot still gets its own
# screen, but all accounts then share its files under /home/bot and its
# browser logins (cookies sync across every screen on it). Only for accounts
# that fully trust each other.
OPENBOTS_COMPUTER_AGENT_SHARED=false

# --- Files --------------------------------------------------------------------

# Uploaded and generated files. In the compose stack this is the `files` volume;
# leave it at /data/files there.
OPENBOTS_FILES_DIR=/data/files

# --- MCP catalog servers ------------------------------------------------------

# Where the catalog's stdio servers (filesystem, postgres) are installed from
# docker/mcp-catalog/package-lock.json. The server image installs them here.
OPENBOTS_MCP_DIR=/opt/openbots/mcp
# From source only: when a server is not installed under OPENBOTS_MCP_DIR, start
# it with `npx -y`, which downloads it and its unpinned dependencies at run
# time. Leave false in production; a missing server then fails to start.
OPENBOTS_MCP_NPX_FALLBACK=false

# --- Limits (PRD section 6) ---------------------------------------------------

# Instance defaults; an admin can override them in Settings. Empty means the
# built-in default, shown in brackets.
OPENBOTS_LIMITS_BOTS_PER_ACCOUNT=50
OPENBOTS_LIMITS_BOTS_PER_GROUP=6
# [50]
OPENBOTS_LIMITS_ROUTINES_PER_BOT=
# [200]
OPENBOTS_LIMITS_SKILLS_PER_ACCOUNT=
# [20]
OPENBOTS_LIMITS_RUN_RECORDS_PER_ROUTINE=
# [1048576]
OPENBOTS_LIMITS_WEBHOOK_PAYLOAD_BYTES=
# [60]
OPENBOTS_LIMITS_SYNC_WEBHOOK_WAIT_SECONDS=
# [26214400]
OPENBOTS_LIMITS_UPLOAD_BYTES=
# Webhook rates, per minute: requests from one address to all endpoints [600],
# failed verifications from one address to one endpoint [10], and deliveries to
# an endpoint that sets no rate limit of its own [60].
OPENBOTS_LIMITS_WEBHOOK_IP_RATE_PER_MIN=
OPENBOTS_LIMITS_WEBHOOK_FAILED_AUTH_PER_MIN=
OPENBOTS_LIMITS_WEBHOOK_ENDPOINT_RATE_PER_MIN=

# Process limits. These apply to every account and are not in Settings; a
# change applies when the server restarts. Empty means the default in brackets.
# Minutes an approval or sign-in request waits for the owner before it
# expires and the waiting runs go on without it [1440, 24 hours].
OPENBOTS_APPROVAL_TTL_MINUTES=
# Minutes an MCP server may go unused before OpenBots stops it; the next call
# starts it again [10].
OPENBOTS_MCP_IDLE_STOP_MINUTES=
# What web_fetch reads: characters of a page handed to the model [40000], and
# seconds to wait for the page [30].
OPENBOTS_WEB_FETCH_MAX_CHARS=
OPENBOTS_WEB_FETCH_TIMEOUT_SECONDS=

# --- Process ------------------------------------------------------------------

# api | worker | all. `all` runs the API, web UI, workers and scheduler in one
# process; split them across containers to scale.
OPENBOTS_ROLE=all
# The server listens on PORT (default 3000). The compose stack maps and
# health-checks port 3000, so change the published port with OPENBOTS_HTTP_PORT
# instead.
# PORT=3000
# Bearer token for GET /metrics, 16 characters or more. Metrics are off while
# it is empty. Generate one with `openssl rand -hex 32`.
OPENBOTS_METRICS_TOKEN=

# Reverse proxies and tunnels in front of OpenBots, as comma-separated addresses
# or CIDR ranges. Their X-Forwarded-For header gives the client's address for
# webhook IP allowlists and rate limits; from anyone else it is ignored. Empty
# means no proxy. The compose stack defaults it to Docker's address pool
# (172.16.0.0/12) less the sandbox network's 172.30.0.0/16, where the ngrok and
# cloudflared tunnels run; set 127.0.0.1/32 there to trust nothing, e.g. when
# port 3000 faces the internet.
TRUSTED_PROXIES=

# A header one of TRUSTED_PROXIES sets to the client's address, read instead of
# X-Forwarded-For, such as fly-client-ip on Fly.io. Empty means X-Forwarded-For.
# From a peer that is not a trusted proxy it is ignored.
OPENBOTS_CLIENT_IP_HEADER=

# --- Docker Compose -----------------------------------------------------------

# Where the images come from: the server is ${OPENBOTS_IMAGE_PREFIX}/server and
# the computer ${OPENBOTS_IMAGE_PREFIX}/computer. The release workflow publishes
# both to ghcr.io/<repository owner>/openbots; point this at a fork's or a
# mirror's namespace to use theirs.
OPENBOTS_IMAGE_PREFIX=ghcr.io/danielpang/openbots
# Image tag to run: a release such as 1.2.0 (or 1.2), or latest for the newest
# release. Without a published image, `docker compose up` builds the server
# from this checkout.
OPENBOTS_VERSION=latest
# Host port for the web UI and API.
OPENBOTS_HTTP_PORT=3000
# The host address it is published on, followed by a colon; every interface
# when unset. The Mac app sets 127.0.0.1: so that only This Mac reaches it.
# OPENBOTS_HTTP_BIND=127.0.0.1:
# The Docker network for the Bots' computers, its subnet, and the server's fixed
# address on it (the sandbox firewall lets only that address reach the
# computers). Change the subnet and the address together if the subnet clashes
# with another network. A second OpenBots stack on the same Docker host (a
# source checkout beside the Mac app's, say) needs its own network name and
# subnet: the Mac app picks its own when it first sets up. The network's
# bridge on the host is named like the network unless OPENBOTS_SANDBOX_BRIDGE
# names it; a bridge name is lower case and at most 15 characters, so a longer
# network name needs one. The sandbox firewall's rules follow the bridge and
# the subnet. Keep the subnet in 172.30.0.0/16, which TRUSTED_PROXIES leaves
# out.
OPENBOTS_SANDBOX_NETWORK=openbots-sbx
OPENBOTS_SANDBOX_BRIDGE=
OPENBOTS_SANDBOX_SUBNET=172.30.255.0/24
OPENBOTS_SANDBOX_SERVER_IP=172.30.255.2
# With OPENBOTS_SANDBOX_EGRESS_PROXY set, true makes the sandbox firewall drop
# every connection a computer opens except to the proxy (and DNS), so its
# allowlist cannot be bypassed. Needs the proxy's IPv4 address in the URL.
OPENBOTS_SANDBOX_EGRESS_PROXY_ONLY=false
# The `egress` profile's proxy: its fixed address on the sandbox network (inside
# OPENBOTS_SANDBOX_SUBNET), and the file of hosts it allows.
OPENBOTS_SANDBOX_EGRESS_PROXY_IP=172.30.255.3
OPENBOTS_SANDBOX_EGRESS_ALLOWLIST=./docker/egress-proxy/allowlist

# Tunnels, see the README. Used only with `--profile ngrok` / `--profile cloudflare`.
NGROK_AUTHTOKEN=
NGROK_URL=
CLOUDFLARE_TUNNEL_TOKEN=

# A private relay of your own, used only with `--profile relay`
# (docker/docker-compose.relay.yml), for a server on a VM with a public
# address. The relay listens on OPENBOTS_RELAY_PORT, on loopback unless
# OPENBOTS_RELAY_BIND says otherwise (0.0.0.0: for every interface). With this
# profile, OPENBOTS_RELAY_URL above is the public wss:// address of that port
# behind TLS: a Cloudflare Tunnel hostname whose service is http://relay:3200
# (the `cloudflare` profile), or a reverse proxy on the host. A relay of your
# own carries no push notifications: only the project's relay holds the
# app's APNs key, so the phone gets notices only while the app is open.
# OPENBOTS_RELAY_PORT=3200
# OPENBOTS_RELAY_BIND=127.0.0.1:
# OPENBOTS_RELAY_TRUST_PROXY=true
# OPENBOTS_RELAY_LOG_LEVEL=info

# Object storage, used only with `--profile s3`. OpenBots itself stores files in
# OPENBOTS_FILES_DIR for now; the MinIO service is there for S3 storage once it
# is supported.
MINIO_ROOT_USER=openbots
MINIO_ROOT_PASSWORD=
