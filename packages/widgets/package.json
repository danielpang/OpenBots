{
  "name": "@openbot/widgets",
  "version": "0.0.0",
  "private": true,
  "description": "widget schemas and React renderers",
  "license": "BUSL-1.1",
  "type": "module",
  "exports": {
    ".": {
      "@openbot/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "@openbot/source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openbot/routines": "workspace:*",
    "@openbot/shared": "workspace:*",
    "@openbot/ui": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "^21.0.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
