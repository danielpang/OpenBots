{
  "name": "@openbot/agent",
  "version": "0.0.0",
  "private": true,
  "description": "run loop, context assembly, tool registry, policy, steering, activity labels",
  "license": "BUSL-1.1",
  "type": "module",
  "exports": {
    ".": {
      "@openbot/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@openbot/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@openbot/computer": "workspace:*",
    "@openbot/models": "workspace:*",
    "@openbot/routines": "workspace:*",
    "@openbot/shared": "workspace:*",
    "@openbot/widgets": "workspace:*",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
