{
  "name": "@openbot/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "generated TypeScript client + WS client",
  "license": "BUSL-1.1",
  "type": "module",
  "exports": {
    ".": {
      "@openbot/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "openapi-typescript openapi.json -o src/schema.ts && prettier --write src/schema.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openbot/shared": "workspace:*",
    "openapi-fetch": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "openapi-typescript": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
