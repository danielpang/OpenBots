{
  "env": {
    "OPENBOTS_COMMIT_GATE": "observe"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-checks.mjs\"",
            "timeout": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-commit-gate.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
