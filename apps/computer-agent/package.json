{
  "name": "@openbot/computer-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Control agent inside the sandbox image",
  "license": "BUSL-1.1",
  "type": "module",
  "exports": {
    ".": {
      "@openbot/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "@openbot/source": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./mcp-stdio": {
      "@openbot/source": "./src/mcp-stdio.ts",
      "types": "./dist/mcp-stdio.d.ts",
      "default": "./dist/mcp-stdio.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/node-pty-helper.mjs"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@openbot/shared": "workspace:*",
    "hono": "catalog:",
    "playwright-core": "^1.64.1",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
